{
  "name": "deepseek-harness-zh_pro",
  "version": "0.6.2",
  "type": "module",
  "description": "综合性增强插件：界面优化、布局调整与提示词注入等更多功能。A comprehensive enhancement plugin with UI polish, layout tweaks, prompt injection, and more.",
  "main": "lib/index.js",
  "bin": {
    "dsh-zh": "bin/dsh-zh.mjs"
  },
  "files": [
    "lib",
    "bin",
    "verify-pairs.cjs",
    "verify-cli.mjs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node verify-pairs.cjs && node verify-cli.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "chinese",
    "zh",
    "enhancement",
    "中文",
    "汉化"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magian1127/deepseek-harness-zh_pro.git"
  },
  "homepage": "https://github.com/magian1127/deepseek-harness-zh_pro#readme",
  "bugs": {
    "url": "https://github.com/magian1127/deepseek-harness-zh_pro/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
